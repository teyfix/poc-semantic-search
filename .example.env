# ==========================================
# 🐘 PostgreSQL (Supabase/Postgres Image)
# ==========================================
# Note: Using supabase/postgres allows for extensions like PGroonga, 
# pgvector, and pgsodium out of the box.

# The name of the default database
POSTGRES_DB="postgres"

# MUST BE "supabase_admin". 
# The Supabase migration scripts (migrate.sh) are hard-coded to use this role.
POSTGRES_USER="supabase_admin"

# IMPORTANT: Choose a strong password. 
# Changing this after the first boot requires wiping the 'volumes/db/data' folder.
POSTGRES_PASSWORD="supersecret"

# ==========================================
# ⚙️ Runtime & Connection
# ==========================================

# Connection string for Node.js / Drizzle.
POSTGRES_URL="postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@pg.lokal:5432/$POSTGRES_DB"
# Uncomment the following line for local development
# POSTGRES_URL="postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@localhost:5432/$POSTGRES_DB"

# ==========================================
# 🤖 AI & LLM (Groq)
# ==========================================
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY="gsk_..."

# Model selection: https://console.groq.com/docs/models
# Recommended for speed/reasoning: llama-3.3-70b-versatile
SUMMARY_MODEL="llama-3.3-70b-versatile"

# Recommended for speed/reasoning: llama-3.3-70b-versatile
# This model will be used for improving user queries
# such as `romance novel` based on user profile (in the future!)
COMPLETION_MODEL="llama-3.3-70b-versatile"

# ==========================================
# 🧠 Embeddings & Vector Search
# ==========================================
# Embedding Server URL
EMBEDDING_SERVER_URL="http://tei.lokal"

# Uncomment the following line for local development
# EMBEDDING_SERVER_URL="http://localhost:8000"

# Leaderboard: https://huggingface.co/spaces/mteb/leaderboard
EMBEDDING_MODEL="BAAI/bge-large-en-v1.5"

# Vector dimensions for the chosen model (e.g., BGE-Large is 1024).
# If you plan to swap models, set this to the largest dimension expected;
# smaller vectors will be zero-padded during processing.
EMBEDDING_DIMENSIONS="1024"
